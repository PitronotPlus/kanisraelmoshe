{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "slug": {
      "type": "string",
      "description": "Slug for URL"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e7\u05e6\u05e8 \u05e9\u05dc \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e9\u05d9\u05d5\u05e6\u05d2 \u05d1\u05db\u05d5\u05ea\u05e8\u05ea"
    },
    "parent_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05dc \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d0\u05d1 (\u05d0\u05dd \u05d6\u05d5 \u05ea\u05ea-\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4)"
    },
    "header_style": {
      "type": "object",
      "description": "\u05e1\u05d2\u05e0\u05d5\u05df \u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "background",
            "line"
          ],
          "default": "background",
          "description": "\u05e1\u05d5\u05d2 \u05d4\u05e1\u05d8\u05d9\u05d9\u05dc - \u05e8\u05e7\u05e2 \u05d0\u05d5 \u05e7\u05d5"
        },
        "image_url": {
          "type": "string",
          "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05e8\u05e7\u05e2 \u05d0\u05d5 \u05d4\u05e7\u05d5"
        }
      },
      "default": {
        "type": "background",
        "image_url": "https://qtrypzzcjebvfcihiynt.supabase.co/storage/v1/object/public/base44-prod/public/68701c57df55f5f96aeb5a04/a2b1f4156_5.png"
      }
    },
    "hero_background_image": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05e8\u05e7\u05e2 \u05dc\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05d4\u05e6\u05d2\u05d4 \u05e9\u05dc \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "page_config": {
      "type": "object",
      "description": "\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05e2\u05d9\u05e6\u05d5\u05d1 \u05d3\u05e3 \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4",
      "properties": {
        "hero_type": {
          "type": "string",
          "enum": [
            "grid",
            "video"
          ],
          "default": "grid",
          "description": "\u05e1\u05d5\u05d2 Hero - \u05e8\u05e9\u05ea \u05d0\u05d5 \u05d5\u05d9\u05d3\u05d0\u05d5"
        },
        "hero_video_url": {
          "type": "string",
          "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d5\u05d9\u05d3\u05d0\u05d5 \u05e2\u05d1\u05d5\u05e8 Hero \u05d5\u05d9\u05d3\u05d0\u05d5"
        },
        "hero_video_title": {
          "type": "string",
          "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05dc\u05d5\u05d9\u05d3\u05d0\u05d5 \u05d4-Hero"
        },
        "article_count": {
          "type": "number",
          "default": 12,
          "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d1\u05d3\u05e3"
        },
        "subcategories_display": {
          "type": "array",
          "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05de\u05e9\u05e0\u05d4 \u05dc\u05d4\u05e6\u05d2\u05d4 \u05d1\u05d3\u05e3",
          "items": {
            "type": "string"
          }
        },
        "related_categories": {
          "type": "array",
          "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05d4\u05e6\u05d2\u05d4 \u05d1\u05e1\u05e8\u05d2\u05dc \u05e6\u05d3",
          "items": {
            "type": "string"
          }
        },
        "show_subcategory_sections": {
          "type": "boolean",
          "default": true,
          "description": "\u05dc\u05d4\u05e6\u05d9\u05d2 \u05e1\u05e7\u05e9\u05e0\u05d9\u05dd \u05e9\u05dc \u05ea\u05ea\u05d9 \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea"
        },
        "layout_style": {
          "type": "string",
          "enum": [
            "classic",
            "modern",
            "magazine"
          ],
          "default": "classic",
          "description": "\u05e1\u05d2\u05e0\u05d5\u05df \u05e4\u05e8\u05d9\u05e1\u05d4 \u05db\u05dc\u05dc\u05d9"
        }
      },
      "default": {}
    }
  },
  "required": [
    "name",
    "slug"
  ]
}