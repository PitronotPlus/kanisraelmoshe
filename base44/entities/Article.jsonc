{
  "name": "Article",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05db\u05ea\u05d1\u05d4"
    },
    "slug": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d9\u05d3\u05d9\u05d3\u05d5\u05ea\u05d9 URL"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05db\u05ea\u05d1\u05d4"
    },
    "excerpt": {
      "type": "string",
      "description": "\u05ea\u05e7\u05e6\u05d9\u05e8 \u05d4\u05db\u05ea\u05d1\u05d4"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e8\u05d0\u05e9\u05d9\u05ea (\u05dc\u05ea\u05d9\u05d0\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8)"
    },
    "subcategory": {
      "type": "string",
      "description": "\u05ea\u05ea-\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 (\u05dc\u05ea\u05d9\u05d0\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8)"
    },
    "categories": {
      "type": "object",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e8\u05d0\u05e9\u05d9\u05ea \u05d5\u05de\u05e9\u05e0\u05d9\u05d5\u05ea \u05dc\u05de\u05d0\u05de\u05e8",
      "properties": {
        "primary": {
          "type": "string",
          "description": "The slug of the primary category"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "An array of slugs for secondary categories"
        }
      },
      "required": [
        "primary"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "pending_approval",
        "rejected"
      ],
      "default": "draft",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05d0\u05de\u05e8"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio"
      ],
      "default": "image",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05d3\u05d9\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d9\u05ea - \u05ea\u05de\u05d5\u05e0\u05d4, \u05d5\u05d9\u05d3\u05d0\u05d5 \u05d0\u05d5 \u05d0\u05d5\u05d3\u05d9\u05d5"
    },
    "featured_image": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05d4 \u05e8\u05d0\u05e9\u05d9\u05ea"
    },
    "featured_image_alt": {
      "type": "string",
      "description": "alt text \u05dc\u05ea\u05de\u05d5\u05e0\u05d4 \u05e8\u05d0\u05e9\u05d9\u05ea"
    },
    "featured_video_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d5\u05d9\u05d3\u05d0\u05d5 \u05e8\u05d0\u05e9\u05d9 (YouTube, Vimeo \u05d5\u05db\u05d3\u05d5\u05de\u05d4)"
    },
    "featured_audio_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05d1\u05e5 \u05d0\u05d5\u05d3\u05d9\u05d5 \u05e8\u05d0\u05e9\u05d9"
    },
    "video_thumbnail": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05ea\u05e6\u05d5\u05d2\u05d4 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 \u05dc\u05d5\u05d9\u05d3\u05d0\u05d5"
    },
    "original_featured_image": {
      "type": "string",
      "description": "URL \u05de\u05e7\u05d5\u05e8\u05d9 \u05e9\u05dc \u05ea\u05de\u05d5\u05e0\u05d4 \u05e8\u05d0\u05e9\u05d9\u05ea \u05dc\u05e4\u05e0\u05d9 \u05e2\u05d9\u05d1\u05d5\u05d3"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05d2\u05d9\u05d5\u05ea"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "\u05db\u05ea\u05d1\u05d4 \u05de\u05d1\u05d9\u05dc\u05d4"
    },
    "hide_featured_image": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05e1\u05ea\u05e8\u05ea \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d9\u05ea \u05d1\u05d2\u05d5\u05e3 \u05d4\u05de\u05d0\u05de\u05e8"
    },
    "published": {
      "type": "boolean",
      "default": false,
      "description": "\u05e4\u05d5\u05e8\u05e1\u05dd"
    },
    "scheduled_publish_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05d4 \u05de\u05ea\u05d5\u05d6\u05de\u05e0\u05d9\u05dd \u05dc\u05e4\u05e8\u05e1\u05d5\u05dd"
    },
    "author": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05db\u05d5\u05ea\u05d1"
    },
    "author_user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05de\u05e7\u05d5\u05e9\u05e8 \u05db\u05db\u05d5\u05ea\u05d1 \u05d4\u05de\u05d0\u05de\u05e8"
    },
    "author_bio": {
      "type": "string",
      "description": "\u05d1\u05d9\u05d5\u05d2\u05e8\u05e4\u05d9\u05d4 \u05e9\u05dc \u05d4\u05db\u05d5\u05ea\u05d1"
    },
    "author_image": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e9\u05dc \u05d4\u05db\u05d5\u05ea\u05d1"
    },
    "author_social_links": {
      "type": "object",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9 \u05e8\u05e9\u05ea\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05db\u05d5\u05ea\u05d1"
    },
    "reading_time": {
      "type": "number",
      "description": "\u05d6\u05de\u05df \u05e7\u05e8\u05d9\u05d0\u05d4 \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "views": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e6\u05e4\u05d9\u05d5\u05ea"
    },
    "seo_title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea SEO"
    },
    "seo_description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05d8\u05d0 SEO"
    },
    "focus_keyword": {
      "type": "string",
      "description": "\u05de\u05d9\u05dc\u05ea \u05de\u05e4\u05ea\u05d7 \u05e8\u05d0\u05e9\u05d9\u05ea"
    },
    "text_direction": {
      "type": "string",
      "enum": [
        "rtl",
        "ltr"
      ],
      "default": "rtl",
      "description": "\u05db\u05d9\u05d5\u05d5\u05e0\u05d9\u05d5\u05ea \u05d4\u05d8\u05e7\u05e1\u05d8"
    },
    "original_source_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05de\u05e7\u05d5\u05e8 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9 \u05e9\u05dc \u05d4\u05de\u05d0\u05de\u05e8, \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05db\u05e4\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea"
    },
    "original_publication_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e4\u05e8\u05e1\u05d5\u05dd \u05d4\u05de\u05e7\u05d5\u05e8\u05d9 \u05e9\u05dc \u05d4\u05de\u05d0\u05de\u05e8 (\u05dc\u05e6\u05d5\u05e8\u05da \u05d9\u05d9\u05d1\u05d5\u05d0)"
    },
    "is_styled": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d0\u05de\u05e8 \u05e2\u05d1\u05e8 \u05e1\u05d2\u05e0\u05d5\u05df \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d4\u05de\u05e1\u05d2\u05e0\u05df"
    },
    "styled_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05d0\u05d7\u05e8\u05d5\u05df \u05e9\u05dc \u05d4\u05de\u05d0\u05de\u05e8"
    }
  },
  "required": [
    "title",
    "content"
  ]
}