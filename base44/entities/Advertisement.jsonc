{
  "name": "Advertisement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05d5\u05d3\u05e2\u05d4"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "image",
        "html",
        "video"
      ],
      "default": "image",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05ea\u05d5\u05db\u05df \u05e9\u05dc \u05d4\u05d1\u05d0\u05e0\u05e8 - \u05ea\u05de\u05d5\u05e0\u05d4, \u05e7\u05d5\u05d3 HTML, \u05d0\u05d5 \u05d5\u05d9\u05d3\u05d0\u05d5"
    },
    "image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05d5\u05d3\u05e2\u05d4 (\u05d0\u05dd content_type \u05d4\u05d5\u05d0 image)"
    },
    "html_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 HTML \u05dc\u05d4\u05d8\u05de\u05e2\u05d4 (\u05d0\u05dd content_type \u05d4\u05d5\u05d0 html)"
    },
    "video_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d5\u05d9\u05d3\u05d0\u05d5 (\u05d0\u05dd content_type \u05d4\u05d5\u05d0 video)"
    },
    "link_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05de\u05d5\u05d3\u05e2\u05d4 (\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05d5\u05d5\u05d9\u05d3\u05d0\u05d5)"
    },
    "position": {
      "type": "string",
      "enum": [
        "header",
        "header_side",
        "sidebar_top",
        "sidebar_bottom",
        "main_leaderboard",
        "between_articles",
        "large_banner"
      ],
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05de\u05d5\u05d3\u05e2\u05d4"
    },
    "size": {
      "type": "string",
      "enum": [
        "banner",
        "square",
        "rectangle",
        "mobile",
        "large",
        "header"
      ],
      "description": "\u05d2\u05d5\u05d3\u05dc \u05d4\u05de\u05d5\u05d3\u05e2\u05d4"
    },
    "advertiser_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e4\u05e8\u05e1\u05dd"
    },
    "advertiser_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e4\u05e8\u05e1\u05dd"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05de\u05d5\u05d3\u05e2\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e7\u05dc\u05d9\u05e7\u05d9\u05dd"
    },
    "impressions": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05e9\u05d9\u05e4\u05d5\u05ea"
    }
  },
  "required": [
    "title",
    "position",
    "content_type"
  ]
}