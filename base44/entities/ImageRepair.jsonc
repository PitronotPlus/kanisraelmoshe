{
  "name": "ImageRepair",
  "type": "object",
  "properties": {
    "article_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d0\u05de\u05e8 \u05d4\u05de\u05e9\u05d5\u05d9\u05da"
    },
    "original_url": {
      "type": "string",
      "description": "\u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9 \u05e9\u05dc \u05d4\u05ea\u05de\u05d5\u05e0\u05d4",
      "unique": true
    },
    "new_url": {
      "type": "string",
      "description": "\u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d7\u05d3\u05e9 \u05e9\u05dc \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05d1\u05e9\u05e8\u05ea \u05e9\u05dc\u05e0\u05d5"
    },
    "source_field": {
      "type": "string",
      "enum": [
        "featured_image",
        "content"
      ],
      "description": "\u05d4\u05d9\u05db\u05df \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05e0\u05de\u05e6\u05d0\u05d4 \u05d1\u05de\u05d0\u05de\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "repaired",
        "failed"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05d9\u05e7\u05d5\u05df \u05d4\u05ea\u05de\u05d5\u05e0\u05d4"
    }
  },
  "required": [
    "article_id",
    "original_url",
    "status"
  ]
}