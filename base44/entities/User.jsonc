{
  "name": "User",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05e6\u05d5\u05d2\u05d4 \u05d4\u05e6\u05d9\u05d1\u05d5\u05e8\u05d9 \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9, \u05e0\u05d9\u05ea\u05df \u05dc\u05e2\u05e8\u05d9\u05db\u05d4"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "editor",
        "advertiser",
        "speaker"
      ],
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05d0\u05d9\u05e9\u05d5\u05e8"
    },
    "requested_app_role": {
      "type": "string",
      "enum": [
        "advertiser",
        "speaker"
      ],
      "description": "\u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e9\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d9\u05e7\u05e9 \u05d1\u05d4\u05e8\u05e9\u05de\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d7\u05e9\u05d1\u05d5\u05df"
    },
    "auto_approve_posts": {
      "type": "boolean",
      "default": false,
      "description": "\u05d0\u05dd \u05de\u05d5\u05e4\u05e2\u05dc, \u05de\u05d0\u05de\u05e8\u05d9 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d9\u05e4\u05d5\u05e8\u05e1\u05de\u05d5 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05d0\u05d9\u05e9\u05d5\u05e8 \u05de\u05e0\u05d4\u05dc"
    },
    "allowed_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d4-slugs \u05e9\u05dc \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05e9\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e8\u05e9\u05d0\u05d9 \u05dc\u05e4\u05e8\u05e1\u05dd \u05d1\u05d4\u05df. \u05d0\u05dd \u05d4\u05e8\u05e9\u05d9\u05de\u05d4 \u05e8\u05d9\u05e7\u05d4, \u05d4\u05d5\u05d0 \u05d9\u05db\u05d5\u05dc \u05dc\u05e4\u05e8\u05e1\u05dd \u05d1\u05db\u05d5\u05dc\u05df."
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "\u05d9\u05ea\u05e8\u05ea \u05ea\u05e7\u05e6\u05d9\u05d1 \u05dc\u05de\u05e4\u05e8\u05e1\u05dd"
    },
    "company": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d7\u05d1\u05e8\u05d4 (\u05dc\u05de\u05e4\u05e8\u05e1\u05de\u05d9\u05dd)"
    },
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "bio": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d0\u05d9\u05e9\u05d9 (\u05dc\u05d3\u05d5\u05d1\u05e8\u05d9\u05dd)"
    },
    "profile_image_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "social_links": {
      "type": "object",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e8\u05e9\u05ea\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea",
      "properties": {
        "facebook": {
          "type": "string"
        },
        "twitter": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "youtube": {
          "type": "string"
        },
        "website": {
          "type": "string"
        }
      }
    }
  },
  "required": []
}